{
  "compilerOptions": {
    "esModuleInterop": true,
    "lib": [
      "ES2023",
      "DOM"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "strict": false,
    "target": "ES2023",
    "types": [
      "node"
    ]
  },
  "include": [
    "checks/**/*.ts"
  ]
}
